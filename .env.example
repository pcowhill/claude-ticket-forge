# TicketForge — Live AI Mode configuration.
# Scripted Demo Mode and Mock AI Mode need NO keys and no .env file at all.
#
# Live AI Mode prefers Anthropic when ANTHROPIC_API_KEY is set,
# otherwise falls back to OpenAI when OPENAI_API_KEY is set.
# Keys are only ever read by the Express backend — never shipped to the browser.

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model id used for ticket forging. Set this to a current Claude model id,
# e.g. a Claude Sonnet class model. Defaults to "claude-sonnet-5" if unset.
ANTHROPIC_MODEL=

# --- OpenAI (fallback provider) ---
OPENAI_API_KEY=
# Defaults to "gpt-4o-mini" if unset.
OPENAI_MODEL=

# --- Server ---
# PORT=8787
